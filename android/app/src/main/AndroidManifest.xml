<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Los avisos de la sesión (gracia y fin) y los push del backend. Se pide
         en contexto, al pulsar Empezar la primera vez (NotificacionesService
         del core):
         https://developer.android.com/develop/ui/views/notifications/notification-permission
         Sin SCHEDULE_EXACT_ALARM ni USE_EXACT_ALARM: el fin se programa
         inexacto (AndroidScheduleMode.inexactAllowWhileIdle). Y sin
         RECEIVE_BOOT_COMPLETED: tras un reinicio la sesión está perdida, así
         que no hay aviso de fin que reprogramar. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- La notificación fija mientras hay sesión es un servicio en primer
         plano (el ForegroundService de flutter_local_notifications, abajo).
         Arrancar uno pide FOREGROUND_SERVICE (Android 9+):
         https://developer.android.com/develop/background-work/services/fgs/declare
         y, en Android 14+, el permiso de su tipo, aquí specialUse:
         https://developer.android.com/develop/background-work/services/fgs/service-types#special-use
         Sin POST_NOTIFICATIONS concedido el servicio arranca igual; solo la
         notificación no se ve en el cajón (sí en el gestor de tareas):
         https://developer.android.com/develop/ui/views/notifications/notification-permission -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- singleTop: un enlace norday-enfoque:// con la app abierta llega a
             onNewIntent de la misma actividad, no abre otra encima.
             https://developer.android.com/guide/topics/manifest/activity-element#lmode -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Fuerza el motor Impeller, como en Norday Habits. -->
            <meta-data
              android:name="io.flutter.embedding.android.EnableImpeller"
              android:value="true"
              />
            <!-- El enlace de entrada lo lee MainActivity.kt y lo pasa a Dart
                 por el canal com.norday.enfoque/sistema. Sin esto, Flutter
                 empujaría además la ruta del enlace en el Navigator, que no
                 tiene rutas con nombre. «If you have written a plugin to
                 handle deep links […] you should opt out the Flutter's default
                 deep link handler. To do this, set […]
                 flutter_deeplinking_enabled to false in AndroidManifest.xml»
                 (https://docs.flutter.dev/ui/navigation/deep-linking). -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- norday-enfoque://sesion?destino=habito&id=N: Norday Habits
                 abre aquí con un hábito de minutos como destino.
                 https://developer.android.com/training/app-links/deep-linking -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="norday-enfoque" android:host="sesion"/>
            </intent-filter>
        </activity>
        <!-- El aviso de fin programado de flutter_local_notifications (su
             README, «AndroidManifest.xml setup»). Sin el receptor de arranque:
             ver arriba. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <!-- La notificación en curso: el servicio en primer plano del plugin
             (su README, «Foreground services»; el nombre tiene que ser
             exactamente este). Tipo specialUse y no mediaPlayback: es un
             temporizador visible, no reproduce nada
             (docs/decisiones/2026-11-27-notificacion-en-curso.md). El tipo
             specialUse obliga a explicar el uso con la propiedad
             PROPERTY_SPECIAL_USE_FGS_SUBTYPE, que Play revisa:
             https://developer.android.com/develop/background-work/services/fgs/service-types#special-use
             https://developer.android.com/reference/android/content/pm/PackageManager#PROPERTY_SPECIAL_USE_FGS_SUBTYPE
             stopWithTask: quitar la app de Recientes pierde la sesión (el
             motor sale y la gracia no se cumple), así que el servicio y su
             notificación se van con ella:
             https://developer.android.com/reference/android/R.attr#stopWithTask -->
        <service
            android:name="com.dexterous.flutterlocalnotifications.ForegroundService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Focus timer: while the user runs a concentration session they started, an ongoing notification shows the countdown to its end and the current round, and keeps the timer running with the screen off. Tapping it returns to the session. It stops when the session ends."/>
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Norday Habits: «Crea hábitos en Norday Habits» la abre con
             getLaunchIntentForPackage (MainActivity.kt). La visibilidad
             limitada de Android 11+ se aplica a esa consulta, y para una app
             concreta se declara su paquete:
             https://developer.android.com/training/package-visibility
             https://developer.android.com/training/package-visibility/declaring
             Los dos: la Focus de Play abre la Habits de Play y la de prueba la
             de prueba (lib/services/abrir_habits.dart). La ficha de Play no
             necesita nada aquí: startActivity con un enlace no requiere
             visibilidad
             (https://developer.android.com/training/package-visibility/use-cases). -->
        <package android:name="com.norday.habitos"/>
        <package android:name="com.norday.habitos.prueba"/>
    </queries>
</manifest>
