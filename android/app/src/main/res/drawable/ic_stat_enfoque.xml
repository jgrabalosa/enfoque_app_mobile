<?xml version="1.0" encoding="utf-8"?>
<!-- Icono pequeño de los avisos de la sesión: un aro con una aguja, blanco
     sobre transparente. Android pinta el icono pequeño solo con su canal
     alfa, así que tiene que ser una silueta de un color
     (https://developer.android.com/develop/ui/views/notifications/custom-notification#icon).
     Genérico y provisional: se sustituye por el definitivo cuando Norday
     Focus tenga icono. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- El aro. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:pathData="M12,3a9,9 0,1 1,0 18a9,9 0,1 1,0 -18z" />
    <!-- La aguja, de las 12 al centro y hacia las 2. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M12,7v5l3,2" />
</vector>
